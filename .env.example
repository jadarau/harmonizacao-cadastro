# LLM Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile
REQUEST_TIMEOUT_S=30
HTTP_MAX_RETRIES=2

# CORS Configuration
ENABLE_CORS=true
CORS_ALLOW_ORIGINS=["*"]

# RAG Configuration - Embedding Service
EMBEDDING_SERVICE_TYPE=sentence_transformer  # Options: sentence_transformer, openai
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2  # For sentence_transformer: all-MiniLM-L6-v2, all-mpnet-base-v2, multi-qa-MiniLM-L6-cos-v1
OPENAI_API_KEY=your_openai_api_key_here  # Only needed if using OpenAI embeddings

# RAG Configuration - Vector Store
VECTOR_STORE_TYPE=chroma  # Options: chroma, faiss
VECTOR_STORE_PATH=./data/vectorstore
CHROMA_COLLECTION_NAME=harmonizacao_docs

# RAG Configuration - Document Processing
DEFAULT_CHUNK_SIZE=1000
DEFAULT_CHUNK_OVERLAP=200
DEFAULT_CHUNKING_STRATEGY=recursive  # Options: fixed_size, sentence, recursive

# RAG Configuration - Retrieval
DEFAULT_MAX_RESULTS=5
DEFAULT_MIN_SCORE=0.3

# File Upload Configuration
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_EXTENSIONS=[".txt", ".md", ".pdf", ".docx", ".doc"]