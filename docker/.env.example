# Arquivo de exemplo para variáveis de ambiente do Docker
# Copie este arquivo para .env e preencha os valores

# API Key do Groq (obrigatório)
GROQ_API_KEY=sua_api_key_aqui

# Configurações MongoDB (já configuradas no docker-compose.yml)
MONGODB_URL=mongodb://admin:admin123@mongodb:27017/harmonizacao?authSource=admin
MONGODB_DATABASE=harmonizacao
MONGODB_COLLECTION_CLIENTES=clientes

# Configurações da aplicação
ENABLE_CORS=true
CORS_ALLOW_ORIGINS=["*"]

# Configurações do Groq
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile
REQUEST_TIMEOUT_S=30.0
HTTP_MAX_RETRIES=2